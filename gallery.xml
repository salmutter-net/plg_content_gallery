<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="4.0" group="content" method="upgrade">
    <name>plg_content_gallery</name>
    <version>1.0.0</version>
    <creationDate>2026.11.13</creationDate>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <copyright>Copyright 2015 salmutter.net – DI Philipp Salmutter. All rights reserved.</copyright>
    <author>Philipp Salmutter</author>
    <authorEmail>philipp@slamutter.net</authorEmail>
    <authorUrl>https://salmutter.net/</authorUrl>
    <description>PLG_CONTENT_GALLERY_XML_DESCRIPTION</description>
    <files>
        <filename plugin="gallery">gallery.php</filename>
        <filename plugin="gallery">index.html</filename>
        <folder plugin="gallery">plugin_gallery</folder>
        <folder>language</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_content_gallery.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.plg_content_gallery.sys.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_content_gallery.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_content_gallery.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_CONTENT_GALLERY_FIELDSET_THUMBNAILS">
                <field
                    name="columns"
                    type="number"
                    label="PLG_CONTENT_GALLERY_COLUMNS_LABEL"
                    description="PLG_CONTENT_GALLERY_COLUMNS_DESC"
                    default="4"
                    min="1"
                    max="12"
                />
                <field
                    name="thumb_max_height"
                    type="number"
                    label="PLG_CONTENT_GALLERY_THUMB_MAX_HEIGHT_LABEL"
                    description="PLG_CONTENT_GALLERY_THUMB_MAX_HEIGHT_DESC"
                    default="180"
                    min="0"
                />
                <field
                    name="thumb_width"
                    type="number"
                    label="PLG_CONTENT_GALLERY_THUMB_WIDTH_LABEL"
                    description="PLG_CONTENT_GALLERY_THUMB_WIDTH_DESC"
                    default="394"
                    min="0"
                />
                <field
                    name="thumb_height"
                    type="number"
                    label="PLG_CONTENT_GALLERY_THUMB_HEIGHT_LABEL"
                    description="PLG_CONTENT_GALLERY_THUMB_HEIGHT_DESC"
                    default="296"
                    min="0"
                />
                <field
                    name="thumb_srcset"
                    type="text"
                    label="PLG_CONTENT_GALLERY_THUMB_SRCSET_LABEL"
                    description="PLG_CONTENT_GALLERY_THUMB_SRCSET_DESC"
                    default="788,1182"
                />
                <field
                    name="thumb_sizes"
                    type="text"
                    label="PLG_CONTENT_GALLERY_THUMB_SIZES_LABEL"
                    description="PLG_CONTENT_GALLERY_THUMB_SIZES_DESC"
                    default="(max-width: 600px) 50vw, 394px"
                />
            </fieldset>
            <fieldset name="full" label="PLG_CONTENT_GALLERY_FIELDSET_FULL">
                <field
                    name="full_width"
                    type="number"
                    label="PLG_CONTENT_GALLERY_FULL_WIDTH_LABEL"
                    description="PLG_CONTENT_GALLERY_FULL_WIDTH_DESC"
                    default="1660"
                    min="0"
                />
                <field
                    name="full_height"
                    type="number"
                    label="PLG_CONTENT_GALLERY_FULL_HEIGHT_LABEL"
                    description="PLG_CONTENT_GALLERY_FULL_HEIGHT_DESC"
                    default="1245"
                    min="0"
                />
                <field
                    name="full_srcset"
                    type="text"
                    label="PLG_CONTENT_GALLERY_FULL_SRCSET_LABEL"
                    description="PLG_CONTENT_GALLERY_FULL_SRCSET_DESC"
                    default="480,768,1024,1280,1660"
                />
                <field
                    name="full_sizes"
                    type="text"
                    label="PLG_CONTENT_GALLERY_FULL_SIZES_LABEL"
                    description="PLG_CONTENT_GALLERY_FULL_SIZES_DESC"
                    default="(max-width: 1660px) 100vw, 1660px"
                />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" name="Gallery Content Plugin">https://raw.githubusercontent.com/salmutter-net/gallery/main/update.xml</server>
    </updateservers>
</extension>
